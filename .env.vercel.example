# ─────────────────────────────────────────────────────────────────────────────
# VELORA on Vercel — environment variables
#
# Vercel → your project → Settings → Environment Variables → "Import .env":
# paste this file's contents with your real values (or upload a filled-in copy).
# Apply to Production (and Preview if you use preview deployments).
# Never commit real values: keep them in a *.local file (git ignores those).
#
# Set automatically — do NOT add these yourself:
#   BACKEND_URL           injected into the storefront by the service binding in vercel.json
#   NODE_ENV, VERCEL, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL   set by Vercel
#   NEXT_PUBLIC_API_URL=/, NEXT_PUBLIC_REALTIME=off, NEXT_PUBLIC_SITE_URL, upload limits
#                         defaulted for Vercel in frontend/next.config.ts
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (database name in the path, e.g. /velora).
# Atlas → Network Access must allow Vercel: add 0.0.0.0/0 (Vercel has no fixed IPs).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/velora?retryWrites=true&w=majority

# 32+ random characters, different from your local one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Owner account — created on first start only if no admin exists yet.
ADMIN_NAME=Store Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL      https://<your-domain>/api/webhooks/stripe
#   Events   checkout.session.completed, checkout.session.expired,
#            checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#            payment_intent.payment_failed, charge.refunded, refund.updated, refund.failed
# then paste that endpoint's signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_...
# Minutes stock stays reserved while a customer is paying (30–1440).
RESERVATION_MINUTES=30

# ── Email (optional; without SMTP, emails are only written to the function logs) ──
# Gmail: smtp.gmail.com, port 465 + SMTP_SECURE=true, SMTP_PASS = a Google "app password".
EMAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VELORA <no-reply@example.com>"

# ── Only when you add your own domain (otherwise the vercel.app address is used) ──
# CLIENT_URL=https://www.yourdomain.com
# API_PUBLIC_URL=https://www.yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

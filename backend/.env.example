# ─────────────────────────────────────────────────────────────
# VELORA API — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Public URL of this API (used in emails and image links)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the storefront (used for redirects and email links)
CLIENT_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string (database name in the path, e.g. /velora)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/velora?retryWrites=true&w=majority

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# lax (API and storefront on the same site, e.g. api.example.com + www.example.com)
# none (API on a different site; requires HTTPS)
COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .example.com
COOKIE_DOMAIN=

# Owner account created on first start if no admin exists
ADMIN_NAME=Store Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Seed the demo catalogue (with images stored in GridFS) when the database is empty
SEED_ON_START=true

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from `stripe listen` (local) or the Dashboard endpoint (production)
STRIPE_WEBHOOK_SECRET=whsec_...

# Minutes stock stays reserved while a customer is in Stripe Checkout (30–1440)
RESERVATION_MINUTES=30

# Optional Redis for BullMQ jobs (reservation expiry, emails). Without it an in-process scheduler is used.
REDIS_URL=

# Optional SMTP. Without it (or with EMAIL_TRANSPORT=log), emails are written to the server log.
# auto = send via SMTP when SMTP_HOST is set | smtp | log
EMAIL_TRANSPORT=auto
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_PASS = a Google "app password"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VELORA <no-reply@example.com>"

# Max image upload size in MB
MAX_UPLOAD_MB=8

# Public URL of the VELORA API (used by the browser for API calls, images and Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL the Next.js server uses to reach the API when rendering pages (can be a private network URL)
API_INTERNAL_URL=http://localhost:4000
# Public URL of this storefront (canonical links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 ONLY when the API is on a different site than the storefront (e.g. storefront on Vercel, API on Render).
# The browser then calls this site's own /api, which is forwarded to NEXT_PUBLIC_API_URL, so login and bag cookies
# work in Safari/iOS. Baked in at build time: redeploy after changing it. Leave empty for local development.
NEXT_PUBLIC_API_PROXY=

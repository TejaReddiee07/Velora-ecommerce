# Public URL of the VELORA API (used by the browser for API calls, images and Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL the Next.js server uses to reach the API when rendering pages (can be a private network URL)
API_INTERNAL_URL=http://localhost:4000
# Public URL of this storefront (canonical links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

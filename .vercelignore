# Files never uploaded by `vercel deploy` from this computer.
# Secrets: production values live in Vercel → Settings → Environment Variables.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!.env.vercel.example

# Local data and logs. (node_modules, .next and dist are NOT listed: they are
# already excluded from Git, and listing them here can strip the packages and
# compiled code out of the API's function on Vercel.)
**/.data
**/*.log
**/test-results
**/playwright-report
**/tsconfig.tsbuildinfo

# Local tooling.
.vscode
.claude
*.bat
Dockerfile
.dockerignore
